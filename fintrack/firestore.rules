// ─────────────────────────────────────────────────────────────────────────────
// PASTE THIS IN:
// Firebase Console → Firestore Database → Rules → Replace all → Publish
// ─────────────────────────────────────────────────────────────────────────────
//
// Each user can ONLY read/write their own data.
// No other user, and no unauthenticated request, can access any document.
// The private subcollection is locked to server only (Firebase Admin SDK).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // private subcollection — server only, never accessible from browser
    // Stores encrypted Drive refresh tokens — no client should ever read this
    match /users/{userId}/private/{document} {
      allow read, write: if false;
    }

    // All other user data — only the owner can read/write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

  }
}
